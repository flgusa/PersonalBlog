@model PersonalBlog.Models.Post

<h1>Удалить?</h1>
<h3>Вы уверены?</h3>
<div>
    <h4>@Model.Title</h4>
    <p>@Model.Content</p>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Удалить" class="btn btn-danger" /> |
    <a asp-action="Index">Назад</a>
</form>
